    {"section": "chorus", "bars": 8, "energy": 0.65, "layers": ["drums", "bass", "pad", "melody", "arp"]},
    {"section": "verse", "bars": 16, "energy": 0.5, "layers": ["drums", "bass", "pad", "melody"]},
